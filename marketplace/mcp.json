{
  "mcpServers": {
    "aix8-pan": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aix8fun/aix8-pan@v1.0.0",
        "aix8-pan"
      ],
      "env": {
        "OPENLIST_URL": "${OPENLIST_URL}",
        "OPENLIST_USER": "${OPENLIST_USER}",
        "OPENLIST_PASS": "${OPENLIST_PASS}",
        "TMDB_HOST": "${TMDB_HOST}",
        "TMDB_API_KEY": "${TMDB_API_KEY}"
      },
      "timeout": 30000
    }
  }
}
